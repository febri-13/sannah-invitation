# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
docs/*
!docs/MEMORY.md

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

#supabase
supabase/.temp
supabase/.config.toml

# vercel
.vercel
.kilo

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Graphify (knowledge graph for AI assistant) ---
# Local metadata - DO NOT COMMIT (mtime cache, cost tracking, cache)
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/cache/
# Additional local artifacts (safe to ignore)
graphify-out/.graphify_labels.json
graphify-out/.graphify_root
graphify-out/.rebuild.lock
# Shareable artifacts - safe to commit
# graphify-out/graph.json
# graphify-out/GRAPH_REPORT.md
# graphify-out/graph.html (optional)

# Seed scripts (contains secrets & dev utilities)
scripts/

# Debug / temp scripts
check-*.mjs
debug-peng*.mjs
